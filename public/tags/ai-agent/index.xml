    <item>
      <title>企业 AI Agent 落地指南：跨越从模型到业务的 7 层漏斗</title>
      <link>http://localhost:1313/posts/%E4%BC%81%E4%B8%9A-ai-agent-%E8%90%BD%E5%9C%B0%E6%8C%87%E5%8D%97%E8%B7%A8%E8%B6%8A%E4%BB%8E%E6%A8%A1%E5%9E%8B%E5%88%B0%E4%B8%9A%E5%8A%A1%E7%9A%84-7-%E5%B1%82%E6%BC%8F%E6%96%97/</link>
